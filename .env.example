# Zetaris (local Docker install, compose project `zetaris`)
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=                 # from Zetaris UI → Management → API Tokens; never commit

# Local Postgres seeded by services/docker-compose.data.yml
WHYTRACE_PG_HOST=localhost
WHYTRACE_PG_PORT=5433
WHYTRACE_PG_DB=authlogs
WHYTRACE_PG_USER=whytrace
WHYTRACE_PG_PASSWORD=change-me   # replace locally; never commit

# Meterless Nightshift runtime (OpenAI-compatible)
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=         # optional: adapter reads Nightshift's proxy-token file when empty
METERLESS_APP=whytrace
MODEL_DEEP=meterless/auto
MODEL_FAST=meterless/fast

# Runtime behaviour
SAMPLE_MODE=false
LOG_LEVEL=info
PORT=8000
MAILGW_PORT=8090
